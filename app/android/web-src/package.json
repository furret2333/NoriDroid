{
	"name": "deeper-android-web",
	"private": true,
	"version": "0.1.0",
	"author": "erhio, Nori, qicajie",
	"type": "module",
	"packageManager": "pnpm@9.15.9",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc --noEmit && vite build",
		"preview": "vite preview",
		"test": "node scripts/run-regression.mjs --fast",
		"test:core": "node tmp-memcheck/run-tests.mjs",
		"test:fast": "node scripts/run-regression.mjs --fast",
		"test:ui": "node scripts/run-regression.mjs --ui",
		"test:all": "node scripts/run-regression.mjs --all",
		"check:growth": "node scripts/check-source-growth.mjs",
		"check:staged": "node scripts/check-staged.mjs",
		"hooks:install": "node scripts/install-git-hooks.mjs",
		"typecheck": "vue-tsc --noEmit",
		"verify:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-apk.ps1",
		"build:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-verified-apk.ps1",
		"test:apk-verification": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-apk-verification.ps1",
		"test:diary": "node scripts/test-diary.mjs",
		"test:settings": "node scripts/test-app-settings.mjs",
		"test:canvas": "node scripts/test-canvas-transform.mjs",
		"test:pomodoro": "node scripts/test-pomodoro.mjs",
		"test:touch": "node tmp-memcheck/run-touch-tests.mjs",
		"test:touch:ui": "node tmp-memcheck/e2e-touch-settings.mjs",
		"postinstall": "node scripts/patch-live2d.mjs",
		"sync:models": "powershell -ExecutionPolicy Bypass -File scripts/sync-models.ps1",
		"test:stage": "node scripts/test-stage-interaction.mjs",
		"test:chat-session": "node scripts/test-chat-session.mjs",
		"test:diary-scheduler": "node scripts/test-diary-scheduler.mjs",
		"test:native-controls": "node scripts/test-native-controls.mjs",
		"test:app-visibility": "node scripts/test-app-visibility.mjs",
		"test:app-resume": "node scripts/test-app-resume.mjs"
	},
	"dependencies": {
		"live2d-easy-control": "^1.0.3",
		"vue": "^3.5.13"
	},
	"devDependencies": {
		"@vitejs/plugin-vue": "^5.2.1",
		"less": "^4.9.0",
		"typescript": "~5.6.2",
		"vite": "^6.0.3",
		"vue-tsc": "^2.1.10"
	}
}
